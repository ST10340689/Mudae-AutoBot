# Mudae Bot Environment Configuration Template
# Copy this file to .env and fill in your details

# Discord Account Credentials
DISCORD_TOKEN=your_token_here
CHANNEL_ID=your_channel_id_here
SERVER_ID=your_server_id_here

# Rolling Settings
ROLL_COMMAND=wx
REPEAT_MINUTE=39
RUN_ON_STARTUP=True
ROLL_DELAY=2.0
RANDOM_JITTER=0.5
MAX_ROLLS_PER_SESSION=60

# AutoClaim & Timing Preferences
MIN_POWER_TO_CLAIM=0
CLAIM_ALL_UNCLAIMED=False
CLAIM_EMOJI=💖
RT_COOLDOWN_HOURS=20.0
AUTO_RT_ON_WISHLIST=True
CHECK_TU_ON_STARTUP=True
CLAIM_COOLDOWN_HOURS=3.0

# Kakera & Sphere Preferences
AUTO_PERK_BONUS_KAKERA=True

# Bonus Daily Commands
POKE_ROLL=False
DAILY_KAKERA=False
DAILY_ROLL=False
